# Example only — install script creates the real secret.
apiVersion: v1
kind: Secret
metadata:
  name: insurance-secrets
  namespace: insurance
type: Opaque
stringData:
  JWT_SECRET: change-me
  POSTGRES_PASSWORD: change-me
  NB_DATABASE_URL: postgresql://insurance:change-me@insurance-postgres-postgresql.insurance.svc.cluster.local:5432/nb_db
  UW_DATABASE_URL: postgresql://insurance:change-me@insurance-postgres-postgresql.insurance.svc.cluster.local:5432/uw_db
  POLICY_DATABASE_URL: postgresql://insurance:change-me@insurance-postgres-postgresql.insurance.svc.cluster.local:5432/policy_db
  CLAIMS_DATABASE_URL: postgresql://insurance:change-me@insurance-postgres-postgresql.insurance.svc.cluster.local:5432/claims_db
  FINANCE_DATABASE_URL: postgresql://insurance:change-me@insurance-postgres-postgresql.insurance.svc.cluster.local:5432/finance_db
  PRODUCT_DATABASE_URL: postgresql://insurance:change-me@insurance-postgres-postgresql.insurance.svc.cluster.local:5432/product_db
  IDENTITY_DATABASE_URL: postgresql://insurance:change-me@insurance-postgres-postgresql.insurance.svc.cluster.local:5432/identity_db
