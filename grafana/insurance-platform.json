  "panels": [
    {
      "title": "HTTP request rate by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Domain events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (event_type, direction, service) (rate(insurance_domain_events_total[5m]))",
          "legendFormat": "{{service}} {{direction}} {{event_type}}"
        }
      ]
    }
  ],
